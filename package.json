{
  "name": "art-director-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {"node": ">=24 <27"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@modelcontextprotocol/client": "2.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
